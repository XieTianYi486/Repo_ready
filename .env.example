# ============================================================
# RepoReady / Git 仓库接入体检 — 环境变量示例
# 复制为 .env 后按需填写。所有变量都是可选的：
# 无 Token、无 AI Key 时，核心扫描功能仍可正常使用。
# 切勿把 .env 提交到 Git。
# ============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000

# ---------- 仓库平台 Token（可选，提高 API 限流额度） ----------
# GitHub: Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=
# Gitee: 设置 -> 私人令牌（只需读公开仓库的权限）
GITEE_TOKEN=

# ---------- AI 建议（可选） ----------
# auto: 有 ANTHROPIC_API_KEY 用 Anthropic；否则有 OPENAI_API_KEY 用兼容接口；否则关闭
# 也可显式设为 anthropic | openai | off
AI_PROVIDER=auto
# 设为 false 可强制关闭 AI（即使配置了 Key）
AI_ENABLED=true
# 是否在打开报告页时自动生成 AI 建议；默认 false，改为 true 开启自动生成
AI_AUTO_GENERATE=false
AI_TIMEOUT_SECONDS=30

# Anthropic Claude（官方 SDK）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 如使用代理或兼容网关，可填写；留空使用官方地址
ANTHROPIC_BASE_URL=

# OpenAI 兼容接口（DeepSeek / 通义 / OpenAI 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 例如 deepseek-chat、qwen-plus；使用 OpenAI 兼容接口时必填
OPENAI_MODEL=

# ---------- 扫描限制（一般无需修改） ----------
MAX_ARCHIVE_MB=50
MAX_EXTRACTED_MB=200
MAX_FILES=5000
SCAN_CONCURRENCY=2
